CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=psyche-r-oss
KERNEL_CONFIG=psyche_user_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=psyche
ADD_LOCALVERSION_TO_FILENAME=false

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
EXTRA_CMDS:LD=aarch64-linux-android-ld KCFLAGS=-Wno-error=strict-prototypes

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r433150
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://mirrors.ustc.edu.cn/aosp/platform/prebuilts/clang/host/linux-x86
CUSTOM_CLANG_BRANCH=android11-dev
CUSTOM_CLANG_VERSION=r377782c

KSU_VARIANT=none
KSU_REF=
KSU_HOOK_MODE=auto

ENABLE_SUSFS=false
ENABLE_KPM=false
