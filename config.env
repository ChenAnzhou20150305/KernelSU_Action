CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=psyche-r-oss
KERNEL_CONFIG=arch/arm64/configs/psyche_user_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

KERNEL_NAME=psyche
ADD_LOCALVERSION_TO_FILENAME=false

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-
EXTRA_CMDS:LD=aarch64-linux-android-ld KCFLAGS=-Wno-error=strict-prototypes

CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false

KSU_VARIANT=sukisu-ultra
KSU_REF=
KSU_HOOK_MODE=auto

ENABLE_SUSFS=false
ENABLE_KPM=false
